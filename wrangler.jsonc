{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "v3digitalstudio",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": ".cloudflare/assets",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "main": "worker/index.ts",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "RESEND_FROM": "V3 Digital Studio <forms@v3digital.studio>",
    "DEV_ORIGIN": ""
  },
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": ["RESEND_API_KEY", "TURNSTILE_SECRET_KEY"]
  },
  "account_id": "a212cf4f1a07edcecca8e4d59afe78f4",
  "routes": [
    {
      "pattern": "v3digital.studio",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false
}
