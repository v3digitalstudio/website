{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": {
    "includes": [
      "**",
      "!!.next",
      "!!.open-next",
      "!!node_modules",
      "!!cloudflare-env.d.ts",
      "!!next-env.d.ts",
      "!!test-results",
      "!!playwright-report",
      "!!public",
      "!!.omo",
      "!!.cloudflare",
      "!!out",
      "!!.wrangler",
      "!!docs/qa-captures",
      "!!.codegraph",
      "!!archive",
      "!!docs",
      "!!DESIGN.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "useImportType": "error",
        "noNonNullAssertion": "error"
      }
    }
  }
}
